{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KoukeNeko/moodle-cli/schema/v1/assignment.show.schema.json",
  "title": "moodle-cli assignment.show",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "data",
    "meta"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "assignment.show"
    },
    "data": {
      "type": "object",
      "required": [
        "id",
        "course_id",
        "cmid",
        "name",
        "due_date",
        "cut_off_date",
        "needs_hand_in",
        "requires_statement",
        "submission_plugins",
        "max_files",
        "max_bytes",
        "description",
        "description_format",
        "max_grade",
        "allow_from",
        "time_limit_seconds",
        "max_attempts",
        "team_submission",
        "blind_marking",
        "submission",
        "attachments",
        "identities_revealed"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "course_id": {
          "type": "string"
        },
        "cmid": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "due_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "cut_off_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "needs_hand_in": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether saving content leaves the work as a draft, so a separate hand-in is required. Null means the route that answered could not see the setting — reading a page cannot — which is not the same as false."
        },
        "requires_statement": {
          "type": "boolean"
        },
        "submission_plugins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_files": {
          "type": [
            "integer",
            "null"
          ]
        },
        "max_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "description": {
          "type": "string",
          "description": "Moodle's own text, passed through unchanged; description_format says how to read it."
        },
        "description_format": {
          "type": "integer",
          "description": "Moodle's text format id: 1 is HTML, 2 plain, 4 markdown."
        },
        "max_grade": {
          "type": [
            "number",
            "null"
          ],
          "description": "Null when the assignment is not graded, which is not the same as being marked out of zero."
        },
        "allow_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "time_limit_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Null when there is no limit"
        },
        "max_attempts": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Null when Moodle allows unlimited attempts; it sends -1 for that"
        },
        "team_submission": {
          "type": "boolean"
        },
        "blind_marking": {
          "type": "boolean"
        },
        "submission": {
          "type": "object",
          "required": [
            "assignment_id",
            "status",
            "handed_in",
            "can_edit",
            "can_submit",
            "grading_status",
            "modified_at",
            "file_count",
            "files",
            "extension_due_date",
            "group_submission",
            "members_still_to_submit",
            "earlier_attempts",
            "timer_ends_at",
            "online_submission"
          ],
          "additionalProperties": false,
          "properties": {
            "assignment_id": {
              "type": "string"
            },
            "status": {
              "enum": [
                "new",
                "draft",
                "reopened",
                "submitted",
                "unknown"
              ],
              "description": "draft means content is saved but is NOT being marked. reopened means a grader opened another attempt, so an earlier attempt was handed in. unknown means the site reported a state this build does not recognise; it is deliberately not folded into one of the others."
            },
            "handed_in": {
              "type": "boolean"
            },
            "can_edit": {
              "type": "boolean"
            },
            "can_submit": {
              "type": "boolean"
            },
            "grading_status": {
              "type": [
                "string",
                "null"
              ]
            },
            "modified_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "file_count": {
              "type": "integer"
            },
            "files": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/file"
              }
            },
            "extension_due_date": {
              "oneOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "This account's own extension, null when none was granted. Granted per person, so the assignment's cut-off may have passed while this account may still submit."
            },
            "group_submission": {
              "type": "boolean",
              "description": "True when this is a group's submission, so handed_in describes the group's work and not this account's."
            },
            "members_still_to_submit": {
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Group members the site says have yet to submit. Null when the reply did not carry the list. Zero still covers both \"none left\" and \"the assignment does not require every member to submit\", so it never proves a group has finished."
            },
            "earlier_attempts": {
              "type": "array",
              "description": "What this account handed in before a grader reopened the assignment, oldest first. Never null; empty means the assignment was never reopened.",
              "items": {
                "type": "object",
                "required": [
                  "number",
                  "status",
                  "file_count",
                  "saved_at"
                ],
                "additionalProperties": false,
                "properties": {
                  "number": {
                    "type": "integer",
                    "description": "Moodle's own attempt number, counting from zero."
                  },
                  "status": {
                    "type": "string"
                  },
                  "file_count": {
                    "type": "integer"
                  },
                  "saved_at": {
                    "oneOf": [
                      {
                        "type": "string",
                        "format": "date-time"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            },
            "timer_ends_at": {
              "oneOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "When a started time limit runs out, null when none is running. Not a deadline: Moodle accepts work afterwards and marks it as over time; the cut-off closes submission."
            },
            "online_submission": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "False for an offline assignment: every submission plugin is switched off and the work is marked from somewhere else — a normal setting, not a fault. Null when the route that answered cannot see the setting."
            }
          }
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          },
          "description": "Files the teacher attached to the description"
        },
        "identities_revealed": {
          "type": "boolean",
          "description": "Anonymity has been lifted. While blind_marking is true and this is false, Moodle can withhold a grade it already holds, so an empty grade is not proof nothing was marked. It says nothing about who can identify the submitter."
        }
      }
    },
    "meta": {
      "$ref": "https://github.com/KoukeNeko/moodle-cli/schema/v1/meta.schema.json"
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": [
        "name",
        "path",
        "size",
        "mime_type",
        "url",
        "modified_at",
        "external"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "Folder within the file area, \"/\" at the top; two files in one area can share a name in different folders"
        },
        "size": {
          "type": "integer"
        },
        "mime_type": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "description": "Fetch it with `moodle file download`, which attaches the credential only for this site"
        },
        "modified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "external": {
          "type": "boolean",
          "description": "Held by another service, such as a linked cloud drive; the site's own token does not necessarily open it"
        }
      }
    }
  }
}
