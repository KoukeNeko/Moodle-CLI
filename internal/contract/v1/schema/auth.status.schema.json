{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KoukeNeko/moodle-cli/schema/v1/auth.status.schema.json",
  "title": "moodle-cli auth.status",
  "type": "object",
  "required": ["schema_version", "kind", "data", "meta"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "auth.status" },
    "data": {
      "type": "object",
      "required": ["site", "account", "username", "user_id", "full_name", "site_name", "release", "valid"],
      "additionalProperties": false,
      "properties": {
        "site": { "type": "string" },
        "account": { "type": ["string", "null"] },
        "username": { "type": ["string", "null"] },
        "user_id": { "type": ["string", "null"] },
        "full_name": { "type": ["string", "null"] },
        "site_name": { "type": ["string", "null"] },
        "release": { "type": ["string", "null"] },
        "valid": { "type": "boolean" }
      }
    },
    "meta": { "$ref": "https://github.com/KoukeNeko/moodle-cli/schema/v1/meta.schema.json" }
  }
}
