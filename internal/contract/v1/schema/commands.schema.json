{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KoukeNeko/moodle-cli/schema/v1/commands.schema.json",
  "title": "moodle-cli command self-description",
  "type": "object",
  "required": ["schema_version", "kind", "data", "meta"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "commands" },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "short", "kind", "mutates", "safety", "idempotency", "flags"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "description": "Space-separated command path" },
          "short": { "type": "string" },
          "kind": { "type": ["string", "null"], "description": "Envelope kind this command emits, null if it emits none" },
          "mutates": { "type": "boolean", "description": "Whether read-only mode withholds the command. What it changes, and where, is safety" },
          "safety": { "type": "string", "enum": ["read", "local", "write"], "description": "read changes nothing; local changes only this machine (configuration, keychain, a downloaded file); write can change something on Moodle" },
          "idempotency": { "type": "string", "enum": ["idempotent", "non_idempotent"], "description": "Whether a failed or unconfirmed run may simply be repeated. Every write is non_idempotent: Moodle functions carry no idempotency key" },
          "flags": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "shorthand", "usage"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "shorthand": { "type": ["string", "null"] },
                "usage": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "meta": { "$ref": "https://github.com/KoukeNeko/moodle-cli/schema/v1/meta.schema.json" }
  }
}
